generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  document  String?    @unique
  planTier  String     @default("trial")
  status    String     @default("active")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
  patients  Patient[]
  roles     Role[]
  units     Unit[]
  users     User[]

  @@map("organizations")
}

model Unit {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean      @default(true)
  address        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("units")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String
  passwordHash   String
  active         Boolean      @default(true)
  roleId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditLogs      AuditLog[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  permissions    RolePermission[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  label String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Patient {
  id                    String              @id @default(cuid())
  organizationId        String
  name                  String
  document              String?
  birthDate             DateTime?
  phone                 String?
  whatsapp              String?
  email                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  active                Boolean             @default(true)
  addressCity           String?
  addressComplement     String?
  addressNumber         String?
  addressState          String?
  addressStreet         String?
  addressZipCode        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  appointments          Appointment[]
  budgets               Budget[]
  medicalRecord         MedicalRecord?
  attachments           PatientAttachment[]
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receivables           Receivable[]
  toothRecords          ToothRecord[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("patients")
}

model PatientAttachment {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  fileName       String
  fileUrl        String
  uploadedBy     String?
  createdAt      DateTime @default(now())
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([patientId])
  @@map("patient_attachments")
}

model MedicalRecord {
  id             String        @id @default(cuid())
  organizationId String
  patientId      String        @unique
  anamnesis      String?
  allergies      String?
  medications    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entries        RecordEntry[]

  @@index([organizationId])
  @@map("medical_records")
}

model RecordEntry {
  id              String        @id @default(cuid())
  organizationId  String
  medicalRecordId String
  authorUserId    String
  type            String
  content         String
  createdAt       DateTime      @default(now())
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([medicalRecordId])
  @@map("record_entries")
}

model ToothRecord {
  id                 String   @id @default(cuid())
  organizationId     String
  patientId          String
  toothNumber        String
  condition          String?
  plannedProcedure   String?
  performedProcedure String?
  notes              String?
  updatedAt          DateTime @updatedAt
  updatedBy          String?
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, toothNumber])
  @@index([organizationId])
  @@map("tooth_records")
}

model Procedure {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  category        String?
  defaultPrice    Decimal          @db.Decimal(10, 2)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appointments    Appointment[]
  budgetItems     BudgetItem[]
  commissionRules CommissionRule[]

  @@index([organizationId])
  @@map("procedures")
}

model Budget {
  id                 String       @id @default(cuid())
  organizationId     String
  patientId          String
  professionalUserId String?
  status             String       @default("draft")
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  items              BudgetItem[]
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  receivable         Receivable?

  @@index([organizationId])
  @@index([patientId])
  @@map("budgets")
}

model BudgetItem {
  id             String    @id @default(cuid())
  organizationId String
  budgetId       String
  procedureId    String
  procedureName  String
  quantity       Int       @default(1)
  unitPrice      Decimal   @db.Decimal(10, 2)
  discount       Decimal   @default(0) @db.Decimal(10, 2)
  total          Decimal   @db.Decimal(10, 2)
  budget         Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  procedure      Procedure @relation(fields: [procedureId], references: [id])

  @@index([organizationId])
  @@index([budgetId])
  @@map("budget_items")
}

model Receivable {
  id             String                  @id @default(cuid())
  organizationId String
  patientId      String
  budgetId       String?                 @unique
  description    String
  totalAmount    Decimal                 @db.Decimal(10, 2)
  status         String                  @default("pending")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  appointmentId  String?                 @unique
  installments   ReceivableInstallment[]
  appointment    Appointment?            @relation(fields: [appointmentId], references: [id])
  budget         Budget?                 @relation(fields: [budgetId], references: [id])
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([patientId])
  @@map("receivables")
}

model ReceivableInstallment {
  id                String            @id @default(cuid())
  organizationId    String
  receivableId      String
  number            Int
  amount            Decimal           @db.Decimal(10, 2)
  dueDate           DateTime
  paidAt            DateTime?
  paymentMethod     String?
  status            String            @default("pending")
  commissionEntries CommissionEntry[]
  receivable        Receivable        @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([receivableId])
  @@map("receivable_installments")
}

model Payable {
  id             String    @id @default(cuid())
  organizationId String
  description    String
  category       String?
  amount         Decimal   @db.Decimal(10, 2)
  dueDate        DateTime
  paidAt         DateTime?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("payables")
}

model CommissionRule {
  id                 String     @id @default(cuid())
  organizationId     String
  professionalUserId String
  procedureId        String?
  percentage         Decimal    @db.Decimal(5, 2)
  createdAt          DateTime   @default(now())
  procedure          Procedure? @relation(fields: [procedureId], references: [id])

  @@index([organizationId])
  @@map("commission_rules")
}

model CommissionEntry {
  id                      String                @id @default(cuid())
  organizationId          String
  professionalUserId      String
  receivableInstallmentId String
  procedureId             String?
  percentageApplied       Decimal               @db.Decimal(5, 2)
  amount                  Decimal               @db.Decimal(10, 2)
  createdAt               DateTime              @default(now())
  receivableInstallment   ReceivableInstallment @relation(fields: [receivableInstallmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([professionalUserId])
  @@map("commission_entries")
}

model ClinicalResource {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  type           String        @default("cadeira")
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  appointments   Appointment[]

  @@index([organizationId])
  @@map("clinical_resources")
}

model Appointment {
  id                 String            @id @default(cuid())
  organizationId     String
  patientId          String
  professionalUserId String
  resourceId         String?
  procedureId        String?
  startsAt           DateTime
  durationMinutes    Int               @default(30)
  status             String            @default("agendada")
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure          Procedure?        @relation(fields: [procedureId], references: [id])
  resource           ClinicalResource? @relation(fields: [resourceId], references: [id])
  receivable         Receivable?

  @@index([organizationId])
  @@index([organizationId, startsAt])
  @@index([patientId])
  @@map("appointments")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
